/**
 * ============================================================================
 *  ProfiloPro_v1.js — Profilo Professionale lettore (v4.19.0)
 * ============================================================================
 *  2026-05-30
 *  Autore: Silvano Straccini / Duemilamusei
 *
 *  Gestisce il profilo professionale del lettore autenticato:
 *  - Assi anagrafici (ruolo, ente, area, dimensione struttura, seniority)
 *  - Interessi sulle 10 dimensioni Matrix (D1-D10)
 *  - Calcolo completezza progressiva
 *  - Sincronizzazione opt-in con CRM/ContactsMatrix
 *
 *  Funzioni pubbliche (tutte gated livello >= 1):
 *    getProfilo()                  — profilo dell'utente in sessione o null
 *    saveProfilo(payload)          — upsert profilo + sync optIn + CRM event
 *    deleteProfilo()               — cancella + right-to-be-forgotten
 *    getDimHelp()                  — help testuale per ogni dimensione
 *    getEnumProfilo()              — enum per popolare la UI
 *    suggestDimensioniByRuolo(r)   — suggerimento dimensioni pre-evidenziate
 *
 *  Dipendenze:
 *    Constants.js (PRO_*, SEG_*, OC_AMBITI)
 *    CurrentUser_v44.js (getRuoloCorrente)
 *    CRM_v1.js (crm_recordEvent, crm_onMatrixOptIn)
 *    Privacy_v1.js (forgetMyData)
 * ============================================================================
 */

var PROFILO_PRO_SHEET = 'ProfiliPro';

/**
 * Crea il foglio ProfiliPro con header se assente. Idempotente.
 */
function ensureSheetProfiliPro_() {
  var ss = getMainSS();
  var sh = ss.getSheetByName(PROFILO_PRO_SHEET);
  if (sh) { return { ok: true, action: 'exists', rows: sh.getLastRow() - 1 }; }
  var headers = ['profileId','email','ruolo_funzione','tipo_ente','area_geografica',
    'dimensione_struttura','seniority','interessi_dimensioni','completezza',
    'consenso_profilazione','consenso_ts','dataCreazione','dataAggiornamento'];
  sh = ss.insertSheet(PROFILO_PRO_SHEET);
  sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  sh.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#EDE7F6');
  sh.setFrozenRows(1);
  Logger.log('ProfiliPro creato con ' + headers.length + ' colonne.');
  return { ok: true, action: 'created', columns: headers.length };
}

// ============================================================================
// FUNZIONI PUBBLICHE
// ============================================================================

/**
 * Restituisce il profilo dell'utente corrente o null se non ha ancora compilato.
 * Gating: livello >= 1 (lettore).
 *
 * @return {Object|null} profilo completo o null
 */
function getProfilo() {
  var user = _proGetUser_();
  if (!user) return null;

  var row = _proFindByEmail_(user.email);
  if (!row) return null;
  return row;
}

/**
 * Salva (upsert) il profilo professionale dell'utente in sessione.
 * Gating: livello >= 1.
 *
 * Logica:
 *  1. Valida payload contro enum
 *  2. Calcola completezza (% campi compilati)
 *  3. Upsert in ProfiliPro (chiave email)
 *  4. Sincronizza optIn.dimensioni in ContactsMatrix
 *  5. Registra evento CRM profilo_salvato (+10pt prima volta, +2pt aggiornamenti)
 *
 * @param {Object} payload { ruolo_funzione, tipo_ente, area_geografica,
 *   dimensione_struttura, seniority, interessi_dimensioni (CSV o array),
 *   consenso_profilazione (bool) }
 * @return {Object} { ok, profileId, completezza, isNew }
 */
function saveProfilo(payload) {
  var user = _proGetUser_();
  if (!user) return { ok: false, error: 'Accesso non autorizzato. Effettua il login.' };

  payload = payload || {};

  // Validazione consenso GDPR (obbligatorio per il primo salvataggio)
  var existing = _proFindByEmail_(user.email);
  if (!existing && payload.consenso_profilazione !== true) {
    return { ok: false, error: 'Il consenso alla profilazione è necessario per salvare il profilo.' };
  }

  // Validazione campi
  var errori = _proValidate_(payload);
  if (errori.length > 0) return { ok: false, error: errori.join('; ') };

  // Normalizza interessi_dimensioni (accetta array o CSV)
  var interessi = '';
  if (Array.isArray(payload.interessi_dimensioni)) {
    interessi = payload.interessi_dimensioni.filter(function(d) {
      return /^D(10|[1-9])$/.test(d);
    }).join(',');
  } else if (typeof payload.interessi_dimensioni === 'string') {
    interessi = payload.interessi_dimensioni.split(',').map(function(s) { return s.trim(); })
      .filter(function(d) { return /^D(10|[1-9])$/.test(d); }).join(',');
  }

  // Completezza
  var completezza = _proCalcCompletezza_(payload, interessi);

  // Upsert
  var ss = getMainSS();
  var sh = ss.getSheetByName(PROFILO_PRO_SHEET);
  if (!sh) {
    ensureSheetProfiliPro_();
    sh = ss.getSheetByName(PROFILO_PRO_SHEET);
  }

  // existing gia' calcolato sopra per check consenso
  var isNew = !existing;
  var now = new Date().toISOString();
  var profileId = existing ? existing.profileId : Utilities.getUuid();

  var rowData = [
    profileId,
    user.email,
    payload.ruolo_funzione || '',
    payload.tipo_ente || '',
    payload.area_geografica || '',
    payload.dimensione_struttura || '',
    payload.seniority || '',
    interessi,
    completezza,
    payload.consenso_profilazione === true,
    payload.consenso_profilazione === true ? now : (existing ? existing.consenso_ts : ''),
    existing ? existing.dataCreazione : now,
    now
  ];

  if (isNew) {
    sh.appendRow(rowData);
  } else {
    // Trova riga e aggiorna
    var data = sh.getDataRange().getValues();
    for (var r = 1; r < data.length; r++) {
      if (String(data[r][1]).toLowerCase() === user.email.toLowerCase()) {
        sh.getRange(r + 1, 1, 1, rowData.length).setValues([rowData]);
        break;
      }
    }
  }

  // Sincronizza opt-in dimensioni con CRM/ContactsMatrix
  _proSyncOptIn_(user.email, interessi);

  // Evento CRM
  if (typeof crm_recordEvent === 'function') {
    try {
      var delta = isNew ? 10 : 2;
      var responseId = _proGetResponseId_(user.email);
      if (responseId) {
        crm_recordEvent(responseId, 'profilo_salvato', delta, {
          completezza: completezza,
          interessi: interessi,
          isNew: isNew
        });
      }
    } catch (e) {
      Logger.log('ProfiloPro: CRM event fallito: ' + e.message);
    }
  }

  return { ok: true, profileId: profileId, completezza: completezza, isNew: isNew };
}

/**
 * Cancella il profilo dell'utente e invoca right-to-be-forgotten.
 * Gating: livello >= 1.
 *
 * @return {Object} { ok }
 */
function deleteProfilo() {
  var user = _proGetUser_();
  if (!user) return { ok: false, error: 'Accesso non autorizzato.' };

  var ss = getMainSS();
  var sh = ss.getSheetByName(PROFILO_PRO_SHEET);
  if (!sh) return { ok: true, note: 'Nessun profilo trovato.' };

  var data = sh.getDataRange().getValues();
  for (var r = 1; r < data.length; r++) {
    if (String(data[r][1]).toLowerCase() === user.email.toLowerCase()) {
      sh.deleteRow(r + 1);
      break;
    }
  }

  // Right-to-be-forgotten
  if (typeof forgetMyData === 'function') {
    try { forgetMyData(user.email); } catch (e) {
      Logger.log('ProfiloPro: forgetMyData fallito: ' + e.message);
    }
  }

  return { ok: true };
}

/**
 * Restituisce l'help testuale per tutte le 10 dimensioni.
 * Non richiede autenticazione (usabile anche per tooltip pubblici).
 *
 * @return {Object} PRO_DIM_HELP
 */
function getDimHelp() {
  return PRO_DIM_HELP;
}

/**
 * Restituisce tutti gli enum necessari per popolare la UI del profilo.
 * Non richiede autenticazione.
 *
 * @return {Object} { ruoli, enti, dimensioneStruttura, seniority, ambiti, dimHelp }
 */
function getEnumProfilo() {
  return {
    ruoli: PRO_RUOLI,
    enti: PRO_ENTI,
    dimensioneStruttura: PRO_DIMENSIONE_STRUTTURA,
    seniority: PRO_SENIORITY,
    ambiti: OC_AMBITI,
    dimHelp: PRO_DIM_HELP
  };
}

/**
 * Suggerisce le dimensioni pre-evidenziate in base al ruolo selezionato.
 *
 * @param {string} ruolo — uno dei valori di PRO_RUOLI
 * @return {Array<string>} es. ['D1','D9','D10']
 */
function suggestDimensioniByRuolo(ruolo) {
  if (!ruolo) return [];
  return PRO_DIM_BY_RUOLO[ruolo] || [];
}

// ============================================================================
// FUNZIONI PRIVATE
// ============================================================================

/**
 * Recupera l'utente corrente verificando autenticazione e livello >= 1.
 * @return {Object|null} { email, nome, livello, ... } o null se non autorizzato
 */
function _proGetUser_() {
  if (typeof getRuoloCorrente !== 'function') return null;
  try {
    var user = getRuoloCorrente();
    if (!user || !user.email || (user.livello || 0) < 1) return null;
    return user;
  } catch (e) {
    Logger.log('ProfiloPro: getRuoloCorrente fallito: ' + e.message);
    return null;
  }
}

/**
 * Cerca un profilo per email nel foglio ProfiliPro.
 * @param {string} email
 * @return {Object|null} riga come oggetto o null
 */
function _proFindByEmail_(email) {
  var ss = getMainSS();
  var sh = ss.getSheetByName(PROFILO_PRO_SHEET);
  if (!sh || sh.getLastRow() < 2) return null;

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var emailLc = String(email).trim().toLowerCase();

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][1]).trim().toLowerCase() === emailLc) {
      var obj = {};
      for (var c = 0; c < headers.length; c++) {
        obj[headers[c]] = data[r][c];
      }
      return obj;
    }
  }
  return null;
}

/**
 * Valida payload profilo contro gli enum definiti.
 * @param {Object} payload
 * @return {Array<string>} lista errori (vuota se valido)
 */
function _proValidate_(payload) {
  var errori = [];

  if (payload.ruolo_funzione && PRO_RUOLI.indexOf(payload.ruolo_funzione) === -1) {
    errori.push('Ruolo non valido');
  }
  if (payload.tipo_ente && PRO_ENTI.indexOf(payload.tipo_ente) === -1) {
    errori.push('Tipo ente non valido');
  }
  if (payload.dimensione_struttura && PRO_DIMENSIONE_STRUTTURA.indexOf(payload.dimensione_struttura) === -1) {
    errori.push('Dimensione struttura non valida');
  }
  if (payload.seniority && PRO_SENIORITY.indexOf(payload.seniority) === -1) {
    errori.push('Seniority non valida');
  }

  return errori;
}

/**
 * Calcola la completezza del profilo come percentuale (0-100).
 * Campi considerati: ruolo, tipo_ente, area_geografica, dimensione_struttura,
 * seniority, interessi (almeno 1 dimensione selezionata), consenso.
 *
 * @param {Object} payload
 * @param {string} interessi — CSV dimensioni
 * @return {number} 0-100
 */
function _proCalcCompletezza_(payload, interessi) {
  var campi = 7; // totale campi possibili
  var compilati = 0;

  if (payload.ruolo_funzione) compilati++;
  if (payload.tipo_ente) compilati++;
  if (payload.area_geografica) compilati++;
  if (payload.dimensione_struttura) compilati++;
  if (payload.seniority) compilati++;
  if (interessi && interessi.length > 0) compilati++;
  if (payload.consenso_profilazione === true) compilati++;

  return Math.round((compilati / campi) * 100);
}

/**
 * Sincronizza le dimensioni di interesse del profilo con il campo optIn.dimensioni
 * in ContactsMatrix, così il digest segmentato riceve le preferenze aggiornate.
 *
 * @param {string} email
 * @param {string} interessiCsv — es. "D6,D7,D8"
 */
function _proSyncOptIn_(email, interessiCsv) {
  var ss = getMainSS();
  var sh = ss.getSheetByName('ContactsMatrix');
  if (!sh || sh.getLastRow() < 2) return;

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iEmail = headers.indexOf('email');
  var iOptIn = headers.indexOf('preferences_json');
  if (iOptIn === -1) iOptIn = 7; // fallback colonna 8 (0-indexed 7)
  if (iEmail === -1) return;

  var emailLc = String(email).trim().toLowerCase();
  var dims = interessiCsv ? interessiCsv.split(',') : [];

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iEmail]).trim().toLowerCase() === emailLc) {
      // Parse optIn esistente
      var optIn = {};
      try {
        var raw = data[r][iOptIn];
        if (raw && typeof raw === 'string') optIn = JSON.parse(raw);
      } catch (e) { optIn = {}; }

      // Aggiorna dimensioni mantenendo gli altri campi
      optIn.dimensioni = dims;

      // Scrivi indietro
      sh.getRange(r + 1, iOptIn + 1).setValue(JSON.stringify(optIn));
      Logger.log('ProfiloPro: sincronizzato optIn.dimensioni per ' + emailLc + ' → [' + dims.join(',') + ']');
      return;
    }
  }
  // Se non trovato in ContactsMatrix, non creiamo una riga — verrà creata al prossimo opt-in
  Logger.log('ProfiloPro: email ' + emailLc + ' non trovata in ContactsMatrix, skip sync.');
}

/**
 * Restituisce statistiche aggregate anonime sui profili compilati.
 * Solo dati aggregati, nessun dato individuale esposto (coerente con /trasparenza).
 * Gating: livello >= 2 (editor/admin).
 *
 * @return {Object} { ok, totale, completezzaMedia, distribuzione: { ruoli:{}, enti:{}, dimensioni:{}, territori:{}, interessi:{} } }
 */
function getProfiloDashboard() {
  var user = _proGetUser_();
  // Richiediamo almeno livello 2 per la dashboard
  if (!user) return { ok: false, error: 'Non autorizzato.' };
  if (typeof getRuoloCorrente === 'function') {
    var u2 = getRuoloCorrente();
    if (!u2 || (u2.livello || 0) < 2) return { ok: false, error: 'Solo editor/admin.' };
  }

  var ss = getMainSS();
  var sh = ss.getSheetByName(PROFILO_PRO_SHEET);
  if (!sh || sh.getLastRow() < 2) {
    return { ok: true, totale: 0, completezzaMedia: 0, distribuzione: { ruoli:{}, enti:{}, dimensioni:{}, territori:{}, interessi:{} } };
  }

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iRuolo = headers.indexOf('ruolo_funzione');
  var iEnte = headers.indexOf('tipo_ente');
  var iArea = headers.indexOf('area_geografica');
  var iDim = headers.indexOf('dimensione_struttura');
  var iInteressi = headers.indexOf('interessi_dimensioni');
  var iCompletezza = headers.indexOf('completezza');

  var stats = {
    ruoli: {},
    enti: {},
    dimensioni: {},
    territori: {},
    interessi: {} // D1-D10 count
  };
  var totale = 0;
  var sommCompletezza = 0;

  for (var r = 1; r < data.length; r++) {
    if (!data[r][1]) continue; // skip righe vuote
    totale++;

    var ruolo = String(data[r][iRuolo] || '').trim();
    var ente = String(data[r][iEnte] || '').trim();
    var area = String(data[r][iArea] || '').trim();
    var dim = String(data[r][iDim] || '').trim();
    var interessi = String(data[r][iInteressi] || '');
    var compl = Number(data[r][iCompletezza]) || 0;

    sommCompletezza += compl;
    if (ruolo) stats.ruoli[ruolo] = (stats.ruoli[ruolo] || 0) + 1;
    if (ente) stats.enti[ente] = (stats.enti[ente] || 0) + 1;
    if (dim) stats.dimensioni[dim] = (stats.dimensioni[dim] || 0) + 1;
    if (area) {
      // Normalizza a regione (prima parola prima della virgola)
      var regione = area.split(',')[0].trim();
      stats.territori[regione] = (stats.territori[regione] || 0) + 1;
    }
    if (interessi) {
      interessi.split(',').forEach(function(d) {
        d = d.trim();
        if (d) stats.interessi[d] = (stats.interessi[d] || 0) + 1;
      });
    }
  }

  return {
    ok: true,
    totale: totale,
    completezzaMedia: totale > 0 ? Math.round(sommCompletezza / totale) : 0,
    distribuzione: stats
  };
}

/**
 * Recupera il responseId dell'utente da ContactsMatrix (per eventi CRM).
 * @param {string} email
 * @return {string|null}
 */
function _proGetResponseId_(email) {
  var ss = getMainSS();
  var sh = ss.getSheetByName('ContactsMatrix');
  if (!sh || sh.getLastRow() < 2) return null;

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iEmail = headers.indexOf('email');
  var iRid = headers.indexOf('response_id');
  if (iEmail === -1 || iRid === -1) return null;

  var emailLc = String(email).trim().toLowerCase();
  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iEmail]).trim().toLowerCase() === emailLc) {
      return String(data[r][iRid] || '');
    }
  }
  return null;
}
