/**
 * ============================================================================
 *  Segnalazioni_v1.js — Segnalazioni Community (v4.19.0)
 * ============================================================================
 *  2026-05-30
 *  Autore: Silvano Straccini / Duemilamusei
 *
 *  Permette ai lettori autenticati di segnalare iniziative, progetti,
 *  buone pratiche. La segnalazione entra in una coda di moderazione
 *  (editor/admin) e, se approvata, viene pubblicata in Items.
 *
 *  Funzioni pubbliche (lettore, livello >= 1):
 *    inviaSegnalazione(payload)    — crea segnalazione con rate-limit
 *    getMieSegnalazioni()          — lista segnalazioni dell'utente
 *
 *  Funzioni pubbliche (editor/admin, livello >= 2): → FASE 4
 *    getSegnalazioniCoda(stato)
 *    approvaSegnalazione(id, note)
 *    rifiutaSegnalazione(id, note)
 *    pubblicaSegnalazione(id)
 *
 *  Funzioni pubbliche (tutte, per home):
 *    getSegnalazioniPubblicate(limit)  — ultime segnalazioni published
 *
 *  Dipendenze:
 *    Constants.js (SEG_TIPI, SEG_RATE_LIMIT)
 *    CurrentUser_v44.js (getRuoloCorrente)
 *    Matrix_tagger.js (_tagMatrixDim_)
 * ============================================================================
 */

var SEG_SHEET = 'Segnalazioni';

/**
 * Crea il foglio Segnalazioni con header se assente. Idempotente.
 */
function ensureSheetSegnalazioni_() {
  var ss = getMainSS();
  var sh = ss.getSheetByName(SEG_SHEET);
  if (sh) { return { ok: true, action: 'exists', rows: sh.getLastRow() - 1 }; }
  var headers = ['segnalazioneId','email_autore','nome_autore','titolo','descrizione',
    'url','tipo','dimensioni','area_geografica','stato','note_redazione',
    'editor_assegnato','dataInvio','dataDecisione','dataPubblicazione'];
  sh = ss.insertSheet(SEG_SHEET);
  sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  sh.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#E8F5E9');
  sh.setFrozenRows(1);
  Logger.log('Segnalazioni creato con ' + headers.length + ' colonne.');
  return { ok: true, action: 'created', columns: headers.length };
}

// ============================================================================
// FUNZIONI PUBBLICHE — LETTORE (livello >= 1)
// ============================================================================

/**
 * Invia una nuova segnalazione. Email/nome presi dalla sessione (mai dal form).
 * Pre-tagga dimensioni con _tagMatrixDim_. Rate-limit per utente.
 *
 * @param {Object} payload { titolo, descrizione, url, tipo, area_geografica, dimensioni (opz. CSV/array) }
 * @return {Object} { ok, segnalazioneId } oppure { ok:false, error }
 */
function inviaSegnalazione(payload) {
  var user = _segGetUser_(1);
  if (!user) return { ok: false, error: 'Accedi per inviare una segnalazione.' };

  payload = payload || {};

  // Validazione campi obbligatori
  if (!payload.titolo || String(payload.titolo).trim().length < 5) {
    return { ok: false, error: 'Il titolo deve avere almeno 5 caratteri.' };
  }
  if (!payload.descrizione || String(payload.descrizione).trim().length < 20) {
    return { ok: false, error: 'La descrizione deve avere almeno 20 caratteri.' };
  }
  // Validazione tipo
  if (payload.tipo && SEG_TIPI.indexOf(payload.tipo) === -1) {
    return { ok: false, error: 'Tipo non valido.' };
  }

  // Rate-limit
  var rateCheck = _segCheckRateLimit_(user.email);
  if (!rateCheck.ok) return rateCheck;

  // Pre-tag dimensioni
  var dimensioni = '';
  if (payload.dimensioni) {
    // L'utente ha editato manualmente
    if (Array.isArray(payload.dimensioni)) {
      dimensioni = payload.dimensioni.filter(function(d) { return /^D(10|[1-9])$/.test(d); }).join(',');
    } else {
      dimensioni = String(payload.dimensioni);
    }
  } else {
    // Auto-tag da testo
    var testo = String(payload.titolo || '') + ' ' + String(payload.descrizione || '');
    if (typeof _tagMatrixDim_ === 'function') {
      try { dimensioni = _tagMatrixDim_(testo) || ''; } catch (e) { dimensioni = ''; }
    }
  }

  // Scrivi in foglio
  var ss = getMainSS();
  var sh = ss.getSheetByName(SEG_SHEET);
  if (!sh) {
    ensureSheetSegnalazioni_();
    sh = ss.getSheetByName(SEG_SHEET);
  }

  var id = 'SEG-' + Utilities.getUuid().substring(0, 8);
  var now = new Date().toISOString();

  var row = [
    id,                                           // segnalazioneId
    user.email,                                   // email_autore
    user.nome || '',                              // nome_autore
    String(payload.titolo).trim(),                // titolo
    String(payload.descrizione).trim(),           // descrizione
    String(payload.url || '').trim(),             // url
    payload.tipo || 'Altro',                      // tipo
    dimensioni,                                   // dimensioni
    String(payload.area_geografica || '').trim(), // area_geografica
    'pending',                                    // stato
    '',                                           // note_redazione
    '',                                           // editor_assegnato
    now,                                          // dataInvio
    '',                                           // dataDecisione
    ''                                            // dataPubblicazione
  ];

  sh.appendRow(row);
  Logger.log('[SEG] Nuova segnalazione ' + id + ' da ' + user.email + ': ' + payload.titolo);

  return { ok: true, segnalazioneId: id, dimensioni: dimensioni };
}

/**
 * Restituisce le segnalazioni dell'utente in sessione (tutte, qualsiasi stato).
 * Ordinate per dataInvio desc.
 *
 * @return {Object} { ok, segnalazioni: [{id, titolo, tipo, stato, dataInvio, note_redazione, dimensioni}] }
 */
function getMieSegnalazioni() {
  var user = _segGetUser_(1);
  if (!user) return { ok: false, error: 'Accedi per vedere le tue segnalazioni.' };

  var sh = getMainSS().getSheetByName(SEG_SHEET);
  if (!sh || sh.getLastRow() < 2) return { ok: true, segnalazioni: [] };

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var emailLc = user.email.toLowerCase();
  var risultati = [];

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][1]).trim().toLowerCase() === emailLc) {
      var obj = {};
      for (var c = 0; c < headers.length; c++) {
        obj[headers[c]] = data[r][c];
      }
      risultati.push(obj);
    }
  }

  // Ordina per dataInvio desc
  risultati.sort(function(a, b) {
    return String(b.dataInvio || '').localeCompare(String(a.dataInvio || ''));
  });

  return { ok: true, segnalazioni: risultati };
}

/**
 * Pre-tagga un testo con le dimensioni Matrix (per anteprima nel form).
 * Esposta per il frontend: l'utente vede i tag suggeriti prima dell'invio.
 *
 * @param {string} testo — titolo + descrizione
 * @return {Object} { ok, dimensioni: 'D6,D7' }
 */
function preTagDimensioni(testo) {
  if (!testo) return { ok: true, dimensioni: '' };
  if (typeof _tagMatrixDim_ !== 'function') return { ok: true, dimensioni: '' };
  try {
    var result = _tagMatrixDim_(String(testo));
    return { ok: true, dimensioni: result || '' };
  } catch (e) {
    return { ok: true, dimensioni: '' };
  }
}

// ============================================================================
// FUNZIONI PUBBLICHE — HOME (nessun gating)
// ============================================================================

/**
 * Restituisce le ultime segnalazioni con stato 'published',
 * ordinate per dataPubblicazione desc.
 *
 * @param {number} [limit=5]
 * @return {Object} { ok, segnalazioni: [{segnalazioneId, titolo, tipo, area_geografica, dimensioni, nome_autore, dataPubblicazione}] }
 */
function getSegnalazioniPubblicate(limit) {
  limit = Number(limit) || 5;
  var sh = getMainSS().getSheetByName(SEG_SHEET);
  if (!sh || sh.getLastRow() < 2) return { ok: true, segnalazioni: [] };

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iStato = headers.indexOf('stato');
  var pubblicati = [];

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iStato]).trim() === 'published') {
      var obj = {};
      for (var c = 0; c < headers.length; c++) {
        obj[headers[c]] = data[r][c];
      }
      // Non esporre email autore pubblicamente
      delete obj.email_autore;
      pubblicati.push(obj);
    }
  }

  // Ordina per dataPubblicazione desc
  pubblicati.sort(function(a, b) {
    return String(b.dataPubblicazione || '').localeCompare(String(a.dataPubblicazione || ''));
  });

  return { ok: true, segnalazioni: pubblicati.slice(0, limit) };
}

// ============================================================================
// FUNZIONI PRIVATE
// ============================================================================

/**
 * Verifica autenticazione e livello minimo.
 * @param {number} minLivello
 * @return {Object|null} user o null
 */
function _segGetUser_(minLivello) {
  if (typeof getRuoloCorrente !== 'function') return null;
  try {
    var user = getRuoloCorrente();
    if (!user || !user.email || (user.livello || 0) < minLivello) return null;
    return user;
  } catch (e) {
    Logger.log('[SEG] getRuoloCorrente fallito: ' + e.message);
    return null;
  }
}

/**
 * Controlla rate-limit: max N segnalazioni/giorno e intervallo minimo tra invii.
 * @param {string} email
 * @return {Object} { ok } o { ok:false, error }
 */
function _segCheckRateLimit_(email) {
  var sh = getMainSS().getSheetByName(SEG_SHEET);
  if (!sh || sh.getLastRow() < 2) return { ok: true };

  var data = sh.getDataRange().getValues();
  var emailLc = String(email).trim().toLowerCase();
  var now = new Date();
  var oggi = now.toISOString().split('T')[0]; // YYYY-MM-DD
  var countOggi = 0;
  var ultimoInvio = null;

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][1]).trim().toLowerCase() !== emailLc) continue;
    var dataInvio = String(data[r][12] || ''); // colonna dataInvio
    if (dataInvio.indexOf(oggi) === 0) countOggi++;
    if (!ultimoInvio || dataInvio > ultimoInvio) ultimoInvio = dataInvio;
  }

  // Check max giornaliero
  if (countOggi >= SEG_RATE_LIMIT.perGiorno) {
    return { ok: false, error: 'Hai raggiunto il limite di ' + SEG_RATE_LIMIT.perGiorno + ' segnalazioni per oggi. Riprova domani!' };
  }

  // Check intervallo minimo
  if (ultimoInvio) {
    var diff = (now.getTime() - new Date(ultimoInvio).getTime()) / 60000; // minuti
    if (diff < SEG_RATE_LIMIT.minIntervalloMin) {
      return { ok: false, error: 'Attendi almeno ' + SEG_RATE_LIMIT.minIntervalloMin + ' minuti tra una segnalazione e l\'altra.' };
    }
  }

  return { ok: true };
}

// ============================================================================
// FUNZIONI PUBBLICHE — MODERAZIONE (editor/admin, livello >= 2)
// ============================================================================

/**
 * Restituisce la coda segnalazioni per stato (default: pending).
 * Gating: livello >= 2.
 *
 * @param {string} [stato='pending'] — 'pending' | 'in_review' | 'approved' | 'all'
 * @return {Object} { ok, segnalazioni: [...] }
 */
function getSegnalazioniCoda(stato) {
  var user = _segGetUser_(2);
  if (!user) return { ok: false, error: 'Solo editor e admin possono accedere alla coda.' };

  stato = stato || 'pending';
  var sh = getMainSS().getSheetByName(SEG_SHEET);
  if (!sh || sh.getLastRow() < 2) return { ok: true, segnalazioni: [] };

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iStato = headers.indexOf('stato');
  var risultati = [];

  for (var r = 1; r < data.length; r++) {
    var sRiga = String(data[r][iStato]).trim();
    if (stato === 'all' || sRiga === stato) {
      var obj = {};
      for (var c = 0; c < headers.length; c++) {
        obj[headers[c]] = data[r][c];
      }
      obj._rowIndex = r + 1; // per update successivo
      risultati.push(obj);
    }
  }

  // Ordina: pending prima, poi per dataInvio desc
  risultati.sort(function(a, b) {
    if (a.stato === 'pending' && b.stato !== 'pending') return -1;
    if (b.stato === 'pending' && a.stato !== 'pending') return 1;
    return String(b.dataInvio || '').localeCompare(String(a.dataInvio || ''));
  });

  return { ok: true, segnalazioni: risultati, count: risultati.length };
}

/**
 * Approva una segnalazione (pending → approved).
 * Gating: livello >= 2.
 *
 * @param {string} id — segnalazioneId
 * @param {string} [note] — nota opzionale dell'editor
 * @return {Object} { ok }
 */
function approvaSegnalazione(id, note) {
  var user = _segGetUser_(2);
  if (!user) return { ok: false, error: 'Non autorizzato.' };
  return _segTransition_(id, 'approved', user.email, note || '');
}

/**
 * Rifiuta una segnalazione (pending → rejected). Nota obbligatoria.
 * Gating: livello >= 2.
 *
 * @param {string} id — segnalazioneId
 * @param {string} note — motivazione (obbligatoria)
 * @return {Object} { ok }
 */
function rifiutaSegnalazione(id, note) {
  var user = _segGetUser_(2);
  if (!user) return { ok: false, error: 'Non autorizzato.' };
  if (!note || String(note).trim().length < 3) {
    return { ok: false, error: 'La nota di motivazione è obbligatoria per il rifiuto.' };
  }
  return _segTransition_(id, 'rejected', user.email, note);
}

/**
 * Pubblica una segnalazione approvata: stato→published, scrive in Items,
 * notifica Telegram.
 * Gating: livello >= 2.
 *
 * @param {string} id — segnalazioneId
 * @return {Object} { ok }
 */
function pubblicaSegnalazione(id) {
  var user = _segGetUser_(2);
  if (!user) return { ok: false, error: 'Non autorizzato.' };

  var ss = getMainSS();
  var sh = ss.getSheetByName(SEG_SHEET);
  if (!sh) return { ok: false, error: 'Foglio Segnalazioni non trovato.' };

  // Trova la riga
  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iId = headers.indexOf('segnalazioneId');
  var iStato = headers.indexOf('stato');
  var rowIdx = -1;
  var seg = null;

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iId]).trim() === String(id).trim()) {
      rowIdx = r + 1;
      seg = {};
      for (var c = 0; c < headers.length; c++) { seg[headers[c]] = data[r][c]; }
      break;
    }
  }

  if (!seg) return { ok: false, error: 'Segnalazione non trovata.' };
  if (seg.stato !== 'approved') {
    return { ok: false, error: 'Solo segnalazioni approvate possono essere pubblicate. Stato attuale: ' + seg.stato };
  }

  var now = new Date().toISOString();

  // 1. Aggiorna stato in Segnalazioni
  var iDataPubb = headers.indexOf('dataPubblicazione');
  sh.getRange(rowIdx, iStato + 1).setValue('published');
  sh.getRange(rowIdx, iDataPubb + 1).setValue(now);

  // 2. Promuovi in Items (foglio contenuti principale)
  var shItems = ss.getSheetByName('Items');
  if (shItems) {
    var itemId = 'COMM-' + String(id).replace('SEG-', '');
    var itemRow = [
      itemId,                                   // ID
      '',                                       // Ambito (vuoto, usa MatrixDim)
      '',                                       // AmbitoLabel
      'Community',                              // Fonte
      seg.url || '',                            // FonteURL
      seg.titolo || '',                         // Titolo
      '',                                       // Estratto
      seg.descrizione || '',                    // SommarioAI
      '',                                       // SommarioEditato
      '',                                       // TagAI
      7,                                        // Score (default buono per community)
      seg.tipo || 'Segnalazione',              // Tipologia
      new Date(),                               // DataPubblicazione
      new Date(),                               // DataAcquisizione
      '',                                       // Scadenza
      false,                                    // Letto
      false,                                    // Salvato
      false,                                    // Archiviato
      false,                                    // InclusiNelDigest
      seg.dimensioni || ''                      // MatrixDim (per digest segmentato)
    ];
    shItems.appendRow(itemRow);
    Logger.log('[SEG] Pubblicata in Items: ' + itemId + ' — ' + seg.titolo);
  }

  // 3. Notifica Telegram
  if (typeof _tgSend_ === 'function') {
    try {
      var msg = '📣 *Nuova segnalazione community pubblicata*\n\n'
        + '• Titolo: ' + (typeof _tgEsc_ === 'function' ? _tgEsc_(seg.titolo) : seg.titolo) + '\n'
        + '• Tipo: ' + (seg.tipo || '-') + '\n'
        + '• Autore: ' + (seg.nome_autore || 'Community') + '\n'
        + (seg.dimensioni ? '• Dimensioni: ' + seg.dimensioni + '\n' : '')
        + (seg.url ? '• Link: ' + seg.url + '\n' : '')
        + '\n_Sinopia · Osservatorio Culturale_';
      _tgSend_(msg);
    } catch (e) {
      Logger.log('[SEG] Telegram notifica fallita: ' + e.message);
    }
  }

  return { ok: true, itemId: 'COMM-' + String(id).replace('SEG-', '') };
}

/**
 * Helper interno: transizione di stato con audit trail.
 */
function _segTransition_(id, nuovoStato, editorEmail, note) {
  var ss = getMainSS();
  var sh = ss.getSheetByName(SEG_SHEET);
  if (!sh) return { ok: false, error: 'Foglio Segnalazioni non trovato.' };

  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var iId = headers.indexOf('segnalazioneId');
  var iStato = headers.indexOf('stato');
  var iNote = headers.indexOf('note_redazione');
  var iEditor = headers.indexOf('editor_assegnato');
  var iDataDec = headers.indexOf('dataDecisione');

  for (var r = 1; r < data.length; r++) {
    if (String(data[r][iId]).trim() === String(id).trim()) {
      var now = new Date().toISOString();
      sh.getRange(r + 1, iStato + 1).setValue(nuovoStato);
      sh.getRange(r + 1, iNote + 1).setValue(note || '');
      sh.getRange(r + 1, iEditor + 1).setValue(editorEmail);
      sh.getRange(r + 1, iDataDec + 1).setValue(now);
      Logger.log('[SEG] ' + id + ' → ' + nuovoStato + ' da ' + editorEmail);
      return { ok: true };
    }
  }
  return { ok: false, error: 'Segnalazione ' + id + ' non trovata.' };
}
